#!/usr/bin/env bash
set -e
export APPDIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export LD_LIBRARY_PATH="$APPDIR/usr/bin/lib:$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# The official GTK plugin configures schemas, pixbuf loaders and input modules.
for hook in "$APPDIR"/apprun-hooks/*.sh; do
  [[ ! -f "$hook" ]] || source "$hook"
done
exec "$APPDIR/usr/bin/spritedawg" "$@"
