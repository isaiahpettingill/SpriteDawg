<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="image/x-aseprite">
    <comment>Aseprite sprite project</comment>
    <alias type="application/x-aseprite"/>
    <glob pattern="*.aseprite"/>
    <glob pattern="*.ase"/>
    <magic priority="60"><match type="little16" value="0xA5E0" offset="4"/></magic>
  </mime-type>
</mime-info>
